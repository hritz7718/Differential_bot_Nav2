<launch>
    <arg name="gui" default="true" description="Start the Gazebo graphical client" />
    <arg name="use_rviz" default="true" description="Start RViz" />
    <let name="urdf_path" value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro" />
    <let name="world_path" value="$(find-pkg-share my_robot_bringup)/worlds/test_world.world" />
    <let name="controllers" value="$(find-pkg-share my_robot_bringup)/config/controllers.yaml" />
    <let name="rviz_config_path" value="$(find-pkg-share my_robot_bringup)/rviz/urdf_config.rviz" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="use_sim_time" value="true" />
        <param name="robot_description" value="$(command 'xacro $(var urdf_path) use_gz:=true')" />
    </node>

    <group if="$(var gui)">
        <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
            <arg name="gz_args" value="-r $(var world_path)" />
        </include>
    </group>
    <group unless="$(var gui)">
        <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
            <arg name="gz_args" value="-r -s --headless-rendering $(var world_path)" />
        </include>
    </group>

    <node pkg="ros_gz_sim" exec="create" args="-world default -topic /robot_description -name my_robot" output="screen" />
    <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen"
          args="/world/default/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock /scan@sensor_msgs/msg/LaserScan[gz.msgs.LaserScan /camera/image_raw@sensor_msgs/msg/Image[gz.msgs.Image /camera/camera_info@sensor_msgs/msg/CameraInfo[gz.msgs.CameraInfo">
        <remap from="/world/default/clock" to="/clock" />
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster --controller-manager /controller_manager --param-file $(var controllers) --controller-manager-timeout 120" output="screen" />
    <node pkg="controller_manager" exec="spawner" args="diff_drive_controller --controller-manager /controller_manager --param-file $(var controllers) --controller-manager-timeout 120 --controller-ros-args &quot;--ros-args -r /diff_drive_controller/odom:=/odom&quot;" output="screen" />
    <node pkg="my_robot_bringup" exec="twist_stamper.py" output="screen">
        <param name="use_sim_time" value="true" />
    </node>
    <node pkg="rviz2" exec="rviz2" output="screen" if="$(var use_rviz)" args="-d $(var rviz_config_path)">
        <param name="use_sim_time" value="true" />
    </node>
</launch>
